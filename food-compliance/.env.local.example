# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL — find it in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser
# Find it in: Supabase Dashboard → Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, never expose to the browser
# Find it in: Supabase Dashboard → Settings → API → Project API keys
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Anthropic API key for the Claude compliance assistant
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend API key for transactional emails (verification, password reset)
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=

# ─── Payments ────────────────────────────────────────────────────────────────
# Stripe secret key — SERVER ONLY, never expose to the browser
# Get it from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=

# Stripe publishable key — safe to expose to the browser
STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret — used to verify webhook payloads are from Stripe
# Get it from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
# The full URL of your deployed app, e.g. https://yourapp.com
# In development use: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
